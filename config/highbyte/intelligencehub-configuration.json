'^'+lineName),'').replace(new RegExp('[0-9]+$'),'');if(!suffix){suffix=k;}var modelName=getModel(suffix,v,areaName);var proc={_name:k,_model:modelName};var attrKeys=Object.keys(v);for(var ki=0;ki<attrKeys.length;ki++){var ak2=attrKeys[ki];var ck=ak2.replace(new RegExp('^'+k+'_?'),'');if(!ck){ck=ak2;}if(ck.charAt(0)==='_'){ck=ck.substring(1);}if(ck==='EngineeringUnits'){continue;}proc[ck]=v[ak2];}var hierKey='Processes_'+modelName;if(!procsByModel[hierKey]){procsByModel[hierKey]=[];}procsByModel[hierKey].push(proc);}}var hierNames=Object.keys(procsByModel);for(var hi=0;hi<hierNames.length;hi++){line[hierNames[hi]]=procsByModel[hierNames[hi]];}lines.push(line);}area['Lines']=lines;areas.push(area);}site['Areas']=areas;sites.push(site);}enterprise['Sites']=sites;stage.setValue(enterprise);"
