      {
        "name": "NameSpace_to_LocalBroker",
        "tags": [],
        "inputStages": [
          "readNamespace"
        ],
        "stages": [
          {
            "name": "readNamespace",
            "display": {
              "position": {
                "x": 240,
                "y": 0
              }
            },
            "description": "Read all namespace data",
            "config": {
              "type": ".SmartQueryConfig",
              "query": {
                "from": [
                  "AnyCompany.**"
                ],
                "where": "",
                "select": {
                  "what": [
                    "value",
                    "path"
                  ],
                  "as": "List",
                  "delim": "."
                }
              },
              "breakup": true
            },
            "outputs": [
              "extractAreas"
            ]
          },
          {
            "name": "extractAreas",
            "display": {
              "position": {
                "x": 480,
                "y": 207
              }
            },
            "description": "Extract areas at site level with dynamic paths",
            "config": {
              "type": ".JavaScriptTransformConfig",
              "transformExpression": "var val = event.value;\nvar siteName = Object.keys(val)[0];          // e.g. \"FoodProcessing\"\nvar siteData = val[siteName];\nvar path = event.metadata.query._path;       // e.g. \"AnyCompany.CedarRapids\"\n\nvar results = [];\nvar areaNames = Object.keys(siteData);\n\nfor (var a = 0; a < areaNames.length; a++) {\n  var areaName = areaNames[a];              // e.g. \"Line1\", \"Line2\"\n  var areaData = siteData[areaName];\n  var metrics = {};\n\n  var keys = Object.keys(areaData);\n  for (var k = 0; k < keys.length; k++) {\n    var key = keys[k];\n    var v = areaData[key];\n    if (typeof v === \"object\" && v !== null) {\n      var subKeys = Object.keys(v);\n      for (var s = 0; s < subKeys.length; s++) {\n        var sk = subKeys[s];\n        if (typeof v[sk] === \"number\" || typeof v[sk] === \"boolean\") {\n          metrics[sk] = v[sk];\n        }\n      }\n    } else if (typeof v === \"number\" || typeof v === \"boolean\") {\n      metrics[key] = v;\n    }\n  }\n\n  results.push({\n    name: areaName,\n    path: path.replace(/\\./g, \"/\") + \"/\" + siteName + \"/\" + areaName,\n    metrics: metrics\n  });\n}\n\nstage.setValue(results);"
            },
            "outputs": [
              "breakupAreas"
            ]
          },
          {
            "name": "breakupAreas",
            "display": {
              "position": {
                "x": 810,
                "y": -98
              }
            },
            "description": "Break up results array into individual area events",
            "config": {
              "type": ".BreakupConfig",
              "breakupType": "array",
              "depth": 1
            },
            "outputs": [
              "writeLocalBroker"
            ]
          },
          {
            "name": "writeLocalBroker",
            "display": {
              "position": {
                "x": 1135,
                "y": -16
              }
            },
            "description": "Write area data to LocalBroker MQTT with dynamic topic",
            "config": {
              "type": ".DynamicWriteConfig",
              "failureOutputs": [],
              "connectionReference": "{{Connection.LocalBroker}}",
              "qualifier": {
                "connectionType": "mqtt",
                "qos": 0,
                "namedRoot": false,
                "retained": false,
                "breakupArrays": false,
                "topic": "{{event.value.path}}"
              },
              "qualifierExpression": "",
              "writeReturn": "ignore"
            },
            "outputs": []
          }
        ],
