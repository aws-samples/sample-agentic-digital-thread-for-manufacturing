# HighByte distribution tar — no longer used (the container now runs the public
# highbyte/intelligence-hub image from Docker Hub). Kept ignored so any leftover
# local/licensed tar is never committed.
highbyte/assets/*.tar

# Generated OPC UA datasets (deterministic; produced by highbyte/generate_datasets.py at synth time)
highbyte/datasets/*.csv
highbyte/datasets/*.csv.gz

# Legacy residue: pre-2026-09 synth copied datasets/config into the source tree
highbyte/components/opc-server/datasets/

# Vite hashed bundles (regenerated by `npm run build` in i3x-explorer).
# The directory itself is tracked via .gitkeep — it is the deploy.sh build
# destination and keeps `COPY static/ static/` in the Dockerfile valid on a
# fresh clone; only the built bundle contents are ignored.
agentic_digital_thread/static/i3x-explorer/*
!agentic_digital_thread/static/i3x-explorer/.gitkeep

# HighByte setup intelligencehub config (overwritten at synth from config/highbyte/)
highbyte/lambda/highbyte-setup/intelligencehub-configuration.json

# Python
__pycache__/
*.pyc
*.pyo
.venv/
.venv-e2e/
*.egg-info/
# Local pyenv/tool-version pin — developer-specific, not part of the codebase
.python-version

# CDK
cdk.out/
cdk.out.*/

# Build output
build/

# Testing
.hypothesis/
.pytest_cache/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
stream_session*
migrate_*.py

# Local notes / handoffs not part of the ADT codebase
*-handoff/
docs/notes/


# Internal-only docs and media — excluded from the public aws-samples export
# (kept locally; untracked via `git rm --cached`)
Recording/
CUSTOMER_SHARE.md
docs/pr-faq.md

# CDK context (account-specific)
cdk.context.json

# Local agent working state is operational and never product content.
.kiro/

# HighByte proprietary license (obtain your own)
*.license
!LICENSE
.ruff_cache/

# Node modules (CDK CLI install via package.json)
node_modules/

# Playwright / e2e debugging artifacts (screenshots dumped at repo root + MCP cache)
.playwright-mcp/
/*.png

# Harness env capture (contains the demo password — never commit; chmod 600)
agentic_digital_thread/tests/harness/.harness-env
agentic_digital_thread/tests/integration/mapping-eval-*.json
# Local development stack (docs/local-development.md)
.env.local
.env
.venv-local/

# Generated performance smoke reports (environment-specific)
docs/perf/smoke-*.json

# Internal working artifacts — not published
docs/reviews/
docs/perf/
docs/campaign-playbook.md
docs/campaign-tracker-template.html
aidlc/
# Local scratchpads / working traces — never product content
docs/scratch/
