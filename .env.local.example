#
# Local development environment for the ADT app (HYBRID stack).
# Copy to .env.local and fill in AWS_PROFILE / AWS_REGION / GRAPH_IDENTIFIER.
#
#   cp .env.local.example .env.local
#
# `scripts/local_dev.sh run` sources .env.local before starting uvicorn.
# See docs/local-development.md.

# ── Auth ──────────────────────────────────────────────────────────────────
# Bypass Cognito only for the documented local stack. The bypass is allowed only
# when DEV_NO_AUTH=1, DEV_MODE=1, and AGENT_MODE=local are all set exactly as
# shown in this file. Any ECS/cloud deployment marker overrides the trio and
# fails closed. Never copy these values into a deployed task environment.
DEV_NO_AUTH=1
DEV_MODE=1
DEV_USER_ID=dev-user-001

# ── Agent execution ─────────────────────────────────────────────────────────
# In-process Strands orchestrator + local MCP system-agent subprocesses.
# AGENT_MODE=local also completes the three-signal local auth contract above.
# Bypasses the AgentCore Gateway/Runtime layer (agents/agent_manager.py).
AGENT_MODE=local

# ── PostgreSQL (local container — matches docker-compose.local.yml) ──────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# "adt_demo" here is the fictitious demo company's database — demo content, not engine identity (see rename plan)
POSTGRES_DB=adt_demo
POSTGRES_USER=postgres
# Required: set your own local-only password; do not reuse this placeholder.
POSTGRES_PASSWORD=replace-with-your-own-local-password
# Leave ERP_POSTGRES_HOST UNSET so every schema (erp_*, mes_*, cmms_*, plm_*,
# iot_historian) is served from the single local database. Set it only if you
# run a separate ERP database locally.
# ERP_POSTGRES_HOST=

# ── AWS / Amazon Bedrock (REAL cloud — needs credentials) ────────────────────
# boto3 honors AWS_PROFILE + AWS_REGION. Use a profile with Bedrock + Neptune
# access, and make sure the models below are enabled in this Region.
AWS_REGION=us-east-1
AWS_PROFILE=your-profile
# Model IDs are region-partition specific (us. / eu. — the code derives only these two). See docs/deployment.md.
BEDROCK_MODEL=global.anthropic.claude-sonnet-5
SYSTEM_AGENT_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0

# ── Demo addon (REQUIRED for the documented onboarding step) ────────────────
# The demo systems (erp, mes-*, cmms, plm) are only REGISTERED in the onboarding
# catalog when the demo addon is on (server._register_demo_systems). Without this
# the catalog is EMPTY and scripts/onboarding_smoketest.py fails with
# "absent from the live onboarding catalog".
ADT_DEMO=1

# ── Runtime-override store ──────────────────────────────────────────────────
# 'none' stops the app reading the PER-DEPLOYMENT SSM toggles
# (/adt/demo-enabled, /adt/live-updates-enabled). The local stack points at a
# real account for Bedrock, so without this a laptop silently inherits that
# account's toggles — an account with /adt/demo-enabled=false will disable the
# demo addon locally and override ADT_DEMO above. Leave UNSET for deployed envs.
ADT_SETTINGS_STORE=none

# ── Knowledge graph backend ──────────────────────────────────────────────────
# 'local' routes ALL graph reads/writes to the local Memgraph container
# (docker-compose.local.yml) over Bolt — so knowledge-graph onboarding and the
# analytics endpoints are fully testable locally. 'neptune' uses the cloud graph
# (which is private and NOT reachable from a laptop — see ADR-0024). The same
# openCypher runs on both; real Neptune remains the pre-merge fidelity gate.
GRAPH_BACKEND=local
MEMGRAPH_URI=bolt://localhost:7687
# Only used when GRAPH_BACKEND=neptune (reachable only from inside the VPC):
GRAPH_IDENTIFIER=

# ── Guardrails ───────────────────────────────────────────────────────────────
# No guardrail is provisioned locally — disable the application path.
GUARDRAIL_ENABLED=false

# ── DynamoDB (intentionally unset) ───────────────────────────────────────────
# Leaving these blank disables persistence of feedback / usage / saved-prompts.
# DynamoDBStorage no-ops when the table name is empty (agents/storage.py) — the
# app runs fine without them.
# FEEDBACK_TABLE_NAME=
# USAGE_TABLE_NAME=
# GUARDRAIL_TABLE_NAME=
# APP_SETTINGS_TABLE_NAME=
# PROMPT_TEMPLATES_TABLE_NAME=
# DASHBOARD_CARDS_TABLE_NAME=
